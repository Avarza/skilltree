{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "ios": { "simulator": true },
      "channel": "development"
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": { "SKILLTREE_ENV": "staging" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "SKILLTREE_ENV": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
